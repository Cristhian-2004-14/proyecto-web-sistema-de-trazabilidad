@page "/production-lots/new"
@attribute [Authorize(Roles = "Administrador,Producción")]
@inject HttpClient Http
@inject NavigationManager Navigation
<PageTitle>Nuevo lote | Palma Verde</PageTitle>
<header class="page-heading"><div><p class="eyebrow">Planificación</p><h1>Nuevo lote</h1><p>Crear el lote no modifica existencias.</p></div><a class="btn btn-light" href="production-lots">Volver</a></header>
@if(!string.IsNullOrWhiteSpace(error)){<div class="alert alert-danger">@error</div>}
<div class="reception-layout"><section class="form-panel reception-form"><EditForm Model="model" OnValidSubmit="Save"><DataAnnotationsValidator/><ValidationSummary/>
<div class="field"><label>Producto</label><InputSelect class="form-select" @bind-Value="model.ProductId"><option value="0">Seleccionar producto</option>@foreach(var x in products.Where(x=>x.IsActive)){<option value="@x.Id">@x.Name (@x.UnitOfMeasure)</option>}</InputSelect></div>
<div class="form-row"><div class="field"><label>Código de lote</label><InputText class="form-control" @bind-Value="model.Code"/></div><div class="field"><label>Fecha de inicio</label><InputDate class="form-control" @bind-Value="model.StartDate"/></div></div>
<div class="field"><label>Unidades planificadas</label><input class="form-control" type="number" min="1" step="1" @bind="model.PlannedQuantity"/><small>Solo se permiten números enteros.</small></div>
<button class="btn btn-primary" disabled="@saving">@(saving?"Registrando...":"Crear lote")</button>
</EditForm></section></div>
@code {
 CreateProductionLotRequest model=new(){StartDate=DateTime.Today}; List<ProductResponse> products=[]; string error=""; bool saving;
 protected override async Task OnInitializedAsync()=>products=await Http.GetFromJsonAsync<List<ProductResponse>>("api/products")??[];
 async Task Save(){saving=true;error="";var response=await Http.PostAsJsonAsync("api/production-lots",model);saving=false;if(response.IsSuccessStatusCode){var created=await response.Content.ReadFromJsonAsync<ProductionLotResponse>();Navigation.NavigateTo($"production-lots/{created!.Id}");return;}await SetError(response,"No fue posible crear el lote.");}
 async Task SetError(HttpResponseMessage response,string fallback){try{error=(await response.Content.ReadFromJsonAsync<ApiError>())?.Message??fallback;}catch{error=fallback;}}
 sealed class ApiError{public string Message{get;set;}="";}
}
