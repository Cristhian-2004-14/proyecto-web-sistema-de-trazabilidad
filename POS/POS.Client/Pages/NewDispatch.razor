@page "/dispatches/new"
@attribute [Authorize(Roles="Administrador,Almacén")]
@inject HttpClient Http
@inject NavigationManager Nav
<PageTitle>Nuevo despacho | Palma Verde</PageTitle>
<header class="page-heading"><div><p class="eyebrow">Salida de inventario</p><h1>Nuevo despacho</h1><p>El registro confirma y descuenta existencias de forma atómica.</p></div><a class="btn btn-light" href="dispatches">Volver</a></header>@if(error!=""){<div class="alert alert-danger">@error</div>}
<div class="reception-layout"><section class="form-panel reception-form"><EditForm Model="model" OnValidSubmit="Save"><DataAnnotationsValidator/><ValidationSummary/><div class="form-row"><div class="field"><label>Destino</label><InputText class="form-control" @bind-Value="model.Destination"/></div><div class="field"><label>Fecha</label><InputDate class="form-control" @bind-Value="model.Date"/></div></div>
<div class="detail-builder"><div class="field"><label>Lote producido</label><select class="form-select" @bind="lotId"><option value="0">Seleccionar lote</option>@foreach(var lot in lots.Where(x=>x.Status==ProductionLotStatuses.Finished&&x.AvailableQuantity>0)){<option value="@lot.Id">@lot.Code · @lot.ProductName · disponible @lot.AvailableQuantity @lot.ProductUnitOfMeasure</option>}</select></div><div class="field"><label>Unidades</label><input class="form-control" type="number" min="1" step="1" @bind="quantity"/></div><button type="button" class="btn btn-light" @onclick="Add">Agregar</button></div>
<table class="table"><thead><tr><th>Lote</th><th>Producto</th><th>Unidades</th><th></th></tr></thead><tbody>@foreach(var d in model.Details){var lot=lots.First(x=>x.Id==d.ProductionLotId);<tr><td><strong>@lot.Code</strong></td><td>@lot.ProductName</td><td>@d.Quantity @lot.ProductUnitOfMeasure</td><td><button type="button" class="btn-link-action" @onclick="()=>model.Details.Remove(d)">Eliminar</button></td></tr>}</tbody></table>
<div class="field mt-3"><label>Observación</label><InputTextArea class="form-control" @bind-Value="model.Observation"/></div><button class="btn btn-primary" disabled="@saving">@(saving?"Confirmando...":"Registrar y confirmar despacho")</button></EditForm></section></div>
@code{CreateDispatchRequest model=new(){Date=DateTime.Today};List<ProductionLotResponse>lots=[];int lotId,quantity;string error="";bool saving;protected override async Task OnInitializedAsync()=>lots=await Http.GetFromJsonAsync<List<ProductionLotResponse>>("api/production-lots")??[];void Add(){var lot=lots.FirstOrDefault(x=>x.Id==lotId);if(lot is null||lot.Status!=ProductionLotStatuses.Finished||quantity<=0||quantity>lot.AvailableQuantity){error="Seleccione un lote finalizado y una cantidad entera que no supere su disponibilidad.";return;}if(model.Details.Any(x=>x.ProductionLotId==lotId)){error="El lote ya fue agregado.";return;}model.Details.Add(new(){ProductId=lot.ProductId,ProductionLotId=lot.Id,Quantity=quantity});lotId=0;quantity=0;error="";}async Task Save(){if(model.Details.Count==0){error="Agregue al menos un lote producido.";return;}saving=true;var r=await Http.PostAsJsonAsync("api/dispatches",model);saving=false;if(r.IsSuccessStatusCode){var x=await r.Content.ReadFromJsonAsync<DispatchResponse>();Nav.NavigateTo($"dispatches/{x!.Id}");return;}try{error=(await r.Content.ReadFromJsonAsync<ApiError>())?.Message??"No fue posible registrar.";}catch{error="No fue posible registrar.";}}class ApiError{public string Message{get;set;}="";}}
