@page "/dispatches/new"
@attribute [Authorize(Roles="Administrador,Almacén")]
@inject HttpClient Http
@inject NavigationManager Nav
<PageTitle>Nuevo despacho | Palma Verde</PageTitle>
<header class="page-heading"><div><p class="eyebrow">Salida de inventario</p><h1>Nuevo despacho</h1><p>El registro confirma y descuenta existencias de forma atómica.</p></div><a class="btn btn-light" href="dispatches">Volver</a></header>@if(error!=""){<div class="alert alert-danger">@error</div>}
<div class="reception-layout"><section class="form-panel reception-form"><EditForm Model="model" OnValidSubmit="Save"><DataAnnotationsValidator/><ValidationSummary/><div class="form-row"><div class="field"><label>Destino</label><InputText class="form-control" @bind-Value="model.Destination"/></div><div class="field"><label>Fecha</label><InputDate class="form-control" @bind-Value="model.Date"/></div></div>
<div class="detail-builder"><div class="field"><label>Producto</label><select class="form-select" @bind="productId"><option value="0">Seleccionar</option>@foreach(var p in products.Where(x=>x.IsActive)){<option value="@p.Id">@p.Name · stock @p.CurrentStock.ToString("N2")</option>}</select></div><div class="field"><label>Cantidad</label><input class="form-control" type="number" min=".01" step=".01" @bind="quantity"/></div><button type="button" class="btn btn-light" @onclick="Add">Agregar</button></div>
<table class="table"><thead><tr><th>Producto</th><th>Cantidad</th><th></th></tr></thead><tbody>@foreach(var d in model.Details){var p=products.First(x=>x.Id==d.ProductId);<tr><td>@p.Name</td><td>@d.Quantity.ToString("N2") @p.UnitOfMeasure</td><td><button type="button" class="btn-link-action" @onclick="()=>model.Details.Remove(d)">Eliminar</button></td></tr>}</tbody></table>
<div class="field mt-3"><label>Observación</label><InputTextArea class="form-control" @bind-Value="model.Observation"/></div><button class="btn btn-primary" disabled="@saving">@(saving?"Confirmando...":"Registrar y confirmar despacho")</button></EditForm></section></div>
@code{CreateDispatchRequest model=new(){Date=DateTime.Today};List<ProductResponse>products=[];int productId;decimal quantity;string error="";bool saving;protected override async Task OnInitializedAsync()=>products=await Http.GetFromJsonAsync<List<ProductResponse>>("api/products")??[];void Add(){var p=products.FirstOrDefault(x=>x.Id==productId);if(p is null||quantity<=0||quantity>p.CurrentStock){error="Seleccione un producto y una cantidad que no supere el stock.";return;}if(model.Details.Any(x=>x.ProductId==productId)){error="El producto ya fue agregado.";return;}model.Details.Add(new(){ProductId=productId,Quantity=quantity});productId=0;quantity=0;error="";}async Task Save(){if(model.Details.Count==0){error="Agregue al menos un producto.";return;}saving=true;var r=await Http.PostAsJsonAsync("api/dispatches",model);saving=false;if(r.IsSuccessStatusCode){var x=await r.Content.ReadFromJsonAsync<DispatchResponse>();Nav.NavigateTo($"dispatches/{x!.Id}");return;}try{error=(await r.Content.ReadFromJsonAsync<ApiError>())?.Message??"No fue posible registrar.";}catch{error="No fue posible registrar.";}}class ApiError{public string Message{get;set;}="";}}
