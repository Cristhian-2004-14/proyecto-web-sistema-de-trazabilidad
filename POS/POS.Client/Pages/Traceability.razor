@page "/traceability"
@attribute [Authorize(Roles="Administrador,Almacén,Producción,Gerencia")]
@inject HttpClient Http
<PageTitle>Trazabilidad | Palma Verde</PageTitle><header class="page-heading"><div><p class="eyebrow">Consulta global</p><h1>Trazabilidad de lotes</h1><p>Busque un lote por su código exacto.</p></div></header><div class="trace-search"><input class="form-control" placeholder="Ej. LP-2026-001" @bind="code"/><button class="btn btn-primary" @onclick="Search">Buscar</button></div>@if(error!=""){<div class="alert alert-danger">@error</div>}
@if(result is not null){<div class="lot-summary"><div><small>Producto</small><strong>@result.Lot.ProductName</strong></div><div><small>Estado</small><strong>@result.Lot.Status</strong></div><div><small>Responsable</small><strong>@result.Lot.Username</strong></div></div><section class="data-panel mb-3"><table class="table"><thead><tr><th>Código</th><th>Inicio</th><th>Fin</th><th>Planificado</th><th>Producido</th></tr></thead><tbody><tr><td>@result.Lot.Code</td><td>@result.Lot.StartDate.ToString("dd/MM/yyyy")</td><td>@(result.Lot.EndDate?.ToString("dd/MM/yyyy")??"—")</td><td>@result.Lot.PlannedQuantity</td><td>@result.Lot.ProducedQuantity</td></tr></tbody></table></section><h2>Materias primas utilizadas</h2><section class="data-panel mb-3"><table class="table"><tbody>@foreach(var m in result.Lot.Materials){<tr><td>@m.RawMaterialName</td><td>@m.QuantityUsed.ToString("N2") @m.UnitOfMeasure</td></tr>}</tbody></table></section><div class="alert alert-warning">@result.ReceptionOriginLimitation</div><h2>Movimientos relacionados</h2><section class="data-panel"><table class="table"><tbody>@foreach(var m in result.Movements){<tr><td>@m.Date.ToString("dd/MM/yyyy HH:mm")</td><td>@m.MovementType</td><td>+@m.Quantity.ToString("N2")</td><td>@m.Reference</td></tr>}</tbody></table></section>}
@code{string code="",error="";LotTraceabilityResponse?result;async Task Search(){error="";result=null;if(string.IsNullOrWhiteSpace(code)){error="Ingrese un código.";return;}var r=await Http.GetAsync("api/traceability/lots/"+Uri.EscapeDataString(code.Trim()));if(r.IsSuccessStatusCode)result=await r.Content.ReadFromJsonAsync<LotTraceabilityResponse>();else error=r.StatusCode==System.Net.HttpStatusCode.NotFound?"No se encontró el lote.":"No fue posible consultar.";}}
