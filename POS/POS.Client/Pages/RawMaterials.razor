@page "/raw-materials"
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
<PageTitle>Materias primas | Palma Verde</PageTitle><header class="page-heading"><div><p class="eyebrow">Base del inventario</p><h1>Materias primas</h1><p>Control inicial de existencias y niveles mínimos.</p></div><button class="btn btn-primary" @onclick="New">Nueva materia prima</button></header><div class="workspace-grid"><section class="data-panel"><table class="table"><thead><tr><th>Materia prima</th><th>Unidad</th><th>Stock</th><th>Mínimo</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var x in items){<tr class="@(x.CurrentStock<=x.MinimumStock?"stock-alert":"")"><td><strong>@x.Name</strong></td><td>@x.UnitOfMeasure</td><td>@x.CurrentStock.ToString("N2")</td><td>@x.MinimumStock.ToString("N2")</td><td><span class="status-chip @(x.IsActive?"":"off")">@(x.IsActive?"Activo":"Inactivo")</span></td><td><button class="btn-link-action" @onclick="()=>Edit(x)">Editar</button></td></tr>}</tbody></table></section><aside class="form-panel"><h2>@(model.Id==0?"Nueva materia prima":"Editar materia prima")</h2><EditForm Model="model" OnValidSubmit="Save"><DataAnnotationsValidator /><div class="field"><label>Nombre</label><InputText class="form-control" @bind-Value="model.Name" /><ValidationMessage For="@(()=>model.Name)" /></div><div class="field"><label>Unidad de medida</label><InputText class="form-control" @bind-Value="model.UnitOfMeasure" /><ValidationMessage For="@(()=>model.UnitOfMeasure)" /></div><div class="field"><label>Stock actual</label><InputNumber class="form-control" @bind-Value="model.CurrentStock" /><ValidationMessage For="@(()=>model.CurrentStock)" /></div><div class="field"><label>Stock mínimo</label><InputNumber class="form-control" @bind-Value="model.MinimumStock" /><ValidationMessage For="@(()=>model.MinimumStock)" /></div><div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="model.IsActive" /><label>Materia prima activa</label></div><button class="btn btn-primary">Guardar cambios</button></EditForm></aside></div>
@code { List<RawMaterial> items=[]; RawMaterial model=new(); protected override async Task OnInitializedAsync()=>await Load(); async Task Load()=>items=await Http.GetFromJsonAsync<List<RawMaterial>>("api/raw-materials")??[]; void New()=>model=new(); void Edit(RawMaterial x)=>model=new(){Id=x.Id,Name=x.Name,UnitOfMeasure=x.UnitOfMeasure,CurrentStock=x.CurrentStock,MinimumStock=x.MinimumStock,IsActive=x.IsActive}; async Task Save(){var r=model.Id==0?await Http.PostAsJsonAsync("api/raw-materials",model):await Http.PutAsJsonAsync($"api/raw-materials/{model.Id}",model);if(r.IsSuccessStatusCode){New();await Load();}} }
