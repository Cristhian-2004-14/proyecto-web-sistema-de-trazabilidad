@page "/raw-materials"
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http

<PageTitle>Materias primas | Palma Verde</PageTitle>

<header class="page-heading">
    <div><p class="eyebrow">Base del inventario</p><h1>Materias primas</h1><p>Control inicial de existencias y niveles mínimos.</p></div>
    <button class="btn btn-primary" @onclick="New">Nueva materia prima</button>
</header>

<div class="workspace-grid single-column">
    <section class="data-panel">
        <table class="table">
            <thead><tr><th>Materia prima</th><th>Unidad</th><th>Stock</th><th>Mínimo</th><th>Estado</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in items)
                {
                    <tr class="@(x.CurrentStock <= x.MinimumStock ? "stock-alert" : "")">
                        <td><strong>@x.Name</strong></td><td>@x.UnitOfMeasure</td><td>@x.CurrentStock.ToString("N2")</td><td>@x.MinimumStock.ToString("N2")</td>
                        <td><span class="status-chip @(x.IsActive ? "" : "off")">@(x.IsActive ? "Activo" : "Inactivo")</span></td>
                        <td><button class="btn-link-action" @onclick="() => Edit(x)">Editar</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

 </div>

@if (showForm)
{
    <div class="modal-backdrop-custom" role="presentation">
        <section class="modal-card-custom" role="dialog" aria-modal="true" aria-labelledby="raw-material-form-title">
            <header class="modal-header-custom">
                <div>
                    <p class="eyebrow">Inventario</p>
                    <h2 id="raw-material-form-title">@(model.Id == 0 ? "Nueva materia prima" : "Editar materia prima")</h2>
                </div>
                <button class="modal-close-custom" type="button" title="Cerrar" aria-label="Cerrar formulario" @onclick="Cancel">×</button>
            </header>
            <EditForm Model="model" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <div class="field"><label>Nombre</label><InputText class="form-control" @bind-Value="model.Name" /><ValidationMessage For="@(() => model.Name)" /></div>
                <div class="field"><label>Unidad de medida</label><InputText class="form-control" @bind-Value="model.UnitOfMeasure" /><ValidationMessage For="@(() => model.UnitOfMeasure)" /></div>
                <div class="field"><label>Stock actual</label><InputNumber class="form-control" @bind-Value="model.CurrentStock" /><ValidationMessage For="@(() => model.CurrentStock)" /></div>
                <div class="field"><label>Stock mínimo</label><InputNumber class="form-control" @bind-Value="model.MinimumStock" /><ValidationMessage For="@(() => model.MinimumStock)" /></div>
                <div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="model.IsActive" /><label>Materia prima activa</label></div>
                <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Guardar cambios</button><button class="btn btn-light" type="button" @onclick="Cancel">Cancelar</button></div>
            </EditForm>
        </section>
    </div>
}

@code {
    private List<RawMaterial> items = [];
    private RawMaterial model = new();
    private bool showForm;

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() => items = await Http.GetFromJsonAsync<List<RawMaterial>>("api/raw-materials") ?? [];

    private void New() { model = new RawMaterial { IsActive = true }; showForm = true; }
    private void Edit(RawMaterial x) { model = new RawMaterial { Id=x.Id, Name=x.Name, UnitOfMeasure=x.UnitOfMeasure, CurrentStock=x.CurrentStock, MinimumStock=x.MinimumStock, IsActive=x.IsActive }; showForm = true; }
    private void Cancel() { model = new(); showForm = false; }

    private async Task Save()
    {
        var response = model.Id == 0 ? await Http.PostAsJsonAsync("api/raw-materials", model) : await Http.PutAsJsonAsync($"api/raw-materials/{model.Id}", model);
        if (response.IsSuccessStatusCode) { Cancel(); await Load(); }
    }
}
