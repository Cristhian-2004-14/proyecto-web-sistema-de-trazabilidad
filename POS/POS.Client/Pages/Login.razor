@page "/login"
@attribute [AllowAnonymous]
@layout EmptyLayout
@inject HttpClient Http
@inject TokenAuthenticationStateProvider Auth
@inject NavigationManager Navigation
<PageTitle>Iniciar sesión | Palma Verde</PageTitle>
<main class="login-shell"><section class="login-story" aria-label="Identidad Palma Verde"><div class="brand-mark"><span>PV</span></div><div><p class="eyebrow">Palma Verde S.A.</p><h1>Del origen al inventario, cada movimiento cuenta.</h1></div><div class="trace-line"><i></i><i></i><i></i><span>Acceso · Control · Trazabilidad</span></div></section><section class="login-panel"><div class="login-card"><p class="eyebrow">Sistema interno</p><h2>Bienvenido</h2><p class="muted">Ingresa con las credenciales asignadas a tu rol.</p><EditForm Model="request" OnValidSubmit="LoginAsync"><DataAnnotationsValidator /><div class="field"><label>Usuario</label><InputText class="form-control" @bind-Value="request.Username" autocomplete="username" /><ValidationMessage For="@(() => request.Username)" /></div><div class="field"><label>Contraseña</label><InputText class="form-control" type="password" @bind-Value="request.Password" autocomplete="current-password" /><ValidationMessage For="@(() => request.Password)" /></div>@if (!string.IsNullOrWhiteSpace(error)) { <div class="alert alert-danger" role="alert">@error</div> }<button class="btn btn-primary w-100" disabled="@busy">@(busy ? "Verificando…" : "Iniciar sesión")</button></EditForm><p class="demo-note">Demo: <strong>admin</strong> · PalmaVerde2026!</p></div></section></main>
@code { private readonly LoginRequest request = new(); private string? error; private bool busy; private async Task LoginAsync() { busy = true; error = null; var response = await Http.PostAsJsonAsync("api/auth/login", request); if (response.IsSuccessStatusCode) { var result = await response.Content.ReadFromJsonAsync<AuthResponse>(); await Auth.SetTokenAsync(result!.Token); Navigation.NavigateTo("/"); } else error = "No se pudo iniciar sesión. Revisa el usuario, la contraseña y el estado de la cuenta."; busy = false; } }
