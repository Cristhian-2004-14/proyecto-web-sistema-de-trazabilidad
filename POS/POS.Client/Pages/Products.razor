@page "/products"
@attribute [Authorize(Roles = "Administrador,Almacén,Producción,Gerencia")]
@inject HttpClient Http
<PageTitle>Productos | Palma Verde</PageTitle>
<header class="page-heading"><div><p class="eyebrow">Catálogo de producto terminado</p><h1>Productos y recetarios</h1><p>Cada producto define las materias primas necesarias para producir una unidad.</p></div><AuthorizeView Roles="Administrador"><Authorized><button class="btn btn-primary" @onclick="New">Nuevo producto</button></Authorized></AuthorizeView></header>
@if(!string.IsNullOrWhiteSpace(error)){<div class="alert alert-danger">@error</div>}
<div class="inventory-filters"><input class="form-control" placeholder="Buscar producto" @bind="search" @bind:event="oninput" /></div>
<div class="workspace-grid"><section class="data-panel"><table class="table"><thead><tr><th>Producto</th><th>Unidad</th><th>Existencias</th><th>Receta</th><th>Estado</th><th></th></tr></thead><tbody>
@foreach(var x in items.Where(x=>string.IsNullOrWhiteSpace(search)||x.Name.Contains(search,StringComparison.OrdinalIgnoreCase))){<tr><td><strong>@x.Name</strong><small>@x.Description</small></td><td>@x.UnitOfMeasure</td><td>@x.CurrentStock</td><td>@x.Recipe.Count ingrediente(s)</td><td><span class="status-chip @(x.IsActive?"":"off")">@(x.IsActive?"Activo":"Inactivo")</span></td><td><AuthorizeView Roles="Administrador"><Authorized><button class="btn-link-action" @onclick="()=>Edit(x)">Editar</button><button class="btn-link-action" @onclick="()=>Toggle(x)">@(x.IsActive?"Desactivar":"Activar")</button></Authorized></AuthorizeView></td></tr>}
</tbody></table></section>
<AuthorizeView Roles="Administrador"><Authorized Context="productAuth"><aside class="form-panel"><h2>@(editingId==0?"Nuevo producto":"Editar producto")</h2><EditForm Model="model" OnValidSubmit="Save" Context="productForm"><DataAnnotationsValidator /><ValidationSummary />
<div class="field"><label>Nombre</label><InputText class="form-control" @bind-Value="model.Name" /></div><div class="field"><label>Descripción</label><InputTextArea class="form-control" @bind-Value="model.Description" /></div><div class="field"><label>Unidad de medida</label><InputText class="form-control" @bind-Value="model.UnitOfMeasure" /></div>
<div class="form-row"><div class="field"><label>Stock actual</label><input class="form-control" type="number" min="0" step="1" @bind="model.CurrentStock" /></div><div class="field"><label>Stock mínimo</label><input class="form-control" type="number" min="0" step="1" @bind="model.MinimumStock" /></div></div>
<h3>Recetario por unidad producida</h3><div class="detail-builder"><div class="field"><label>Materia prima</label><select class="form-select" @bind="recipeMaterialId"><option value="0">Seleccionar</option>@foreach(var m in materials){<option value="@m.Id">@m.Name (@m.UnitOfMeasure)</option>}</select></div><div class="field"><label>Cantidad por unidad</label><input class="form-control" type="number" min="0.0001" step="0.0001" @bind="recipeQuantity" /></div><button type="button" class="btn btn-light" @onclick="AddRecipeItem">Agregar</button></div>
<table class="table"><thead><tr><th>Materia prima</th><th>Cantidad por unidad</th><th></th></tr></thead><tbody>@if(model.Recipe.Count==0){<tr><td colspan="3" class="muted">La receta debe tener al menos un ingrediente.</td></tr>}@foreach(var r in model.Recipe){var m=materials.FirstOrDefault(x=>x.Id==r.RawMaterialId);<tr><td>@m?.Name</td><td>@r.QuantityPerUnit.ToString("0.####") @m?.UnitOfMeasure</td><td><button type="button" class="btn-link-action" @onclick="()=>model.Recipe.Remove(r)">Eliminar</button></td></tr>}</tbody></table>
<div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="model.IsActive" /><label>Producto activo</label></div><button class="btn btn-primary" disabled="@saving">@(saving?"Guardando...":"Guardar cambios")</button></EditForm></aside></Authorized></AuthorizeView></div>
@code {
 List<ProductResponse> items=[]; List<RawMaterialInventoryResponse> materials=[]; ProductRequest model=new(); int editingId,recipeMaterialId; decimal recipeQuantity; string search="",error=""; bool saving;
 protected override async Task OnInitializedAsync(){materials=await Http.GetFromJsonAsync<List<RawMaterialInventoryResponse>>("api/inventory/raw-materials?isActive=true")??[];await Load();}
 async Task Load()=>items=await Http.GetFromJsonAsync<List<ProductResponse>>("api/products")??[];
 void New(){editingId=0;model=new(){IsActive=true,UnitOfMeasure="unidad"};recipeMaterialId=0;recipeQuantity=0;error="";}
 void Edit(ProductResponse x){editingId=x.Id;model=new(){Name=x.Name,Description=x.Description,UnitOfMeasure=x.UnitOfMeasure,CurrentStock=x.CurrentStock,MinimumStock=x.MinimumStock,IsActive=x.IsActive,Recipe=x.Recipe.Select(r=>new ProductRecipeItemRequest{RawMaterialId=r.RawMaterialId,QuantityPerUnit=r.QuantityPerUnit}).ToList()};error="";}
 void AddRecipeItem(){if(recipeMaterialId<=0||recipeQuantity<=0){error="Seleccione una materia prima e ingrese una cantidad por unidad mayor que cero.";return;}if(model.Recipe.Any(x=>x.RawMaterialId==recipeMaterialId)){error="La materia prima ya forma parte de la receta.";return;}model.Recipe.Add(new(){RawMaterialId=recipeMaterialId,QuantityPerUnit=recipeQuantity});recipeMaterialId=0;recipeQuantity=0;error="";}
 async Task Save(){if(model.Recipe.Count==0){error="Debe agregar al menos una materia prima a la receta.";return;}saving=true;error="";var r=editingId==0?await Http.PostAsJsonAsync("api/products",model):await Http.PutAsJsonAsync($"api/products/{editingId}",model);saving=false;if(r.IsSuccessStatusCode){New();await Load();return;}await SetError(r,"No fue posible guardar el producto.");}
 async Task Toggle(ProductResponse x){var r=await Http.PatchAsJsonAsync($"api/products/{x.Id}/status",new ProductStatusRequest{IsActive=!x.IsActive});if(r.IsSuccessStatusCode)await Load();}
 async Task SetError(HttpResponseMessage response,string fallback){try{error=(await response.Content.ReadFromJsonAsync<ApiError>())?.Message??fallback;}catch{error=fallback;}}
 sealed class ApiError{public string Message{get;set;}="";}
}
