@page "/products"
@attribute [Authorize(Roles = "Administrador,Almacén,Producción,Gerencia")]
@inject HttpClient Http
<PageTitle>Productos | Palma Verde</PageTitle>
<header class="page-heading"><div><p class="eyebrow">Catálogo de producto terminado</p><h1>Productos</h1><p>El stock se conserva como referencia; sus movimientos corresponden a Sprints posteriores.</p></div><AuthorizeView Roles="Administrador"><Authorized><button class="btn btn-primary" @onclick="New">Nuevo producto</button></Authorized></AuthorizeView></header>
<div class="inventory-filters"><input class="form-control" placeholder="Buscar producto" @bind="search" @bind:event="oninput" /></div>
<div class="workspace-grid"><section class="data-panel"><table class="table"><thead><tr><th>Producto</th><th>Unidad</th><th>Stock</th><th>Mínimo</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var x in items.Where(x=>string.IsNullOrWhiteSpace(search)||x.Name.Contains(search,StringComparison.OrdinalIgnoreCase))){<tr><td><strong>@x.Name</strong><small>@x.Description</small></td><td>@x.UnitOfMeasure</td><td>@x.CurrentStock.ToString("N2")</td><td>@x.MinimumStock.ToString("N2")</td><td><span class="status-chip @(x.IsActive?"":"off")">@(x.IsActive?"Activo":"Inactivo")</span></td><td><AuthorizeView Roles="Administrador"><Authorized><button class="btn-link-action" @onclick="()=>Edit(x)">Editar</button><button class="btn-link-action" @onclick="()=>Toggle(x)">@(x.IsActive?"Desactivar":"Activar")</button></Authorized></AuthorizeView></td></tr>}</tbody></table></section>
<AuthorizeView Roles="Administrador"><Authorized Context="productAuth"><aside class="form-panel"><h2>@(editingId==0?"Nuevo producto":"Editar producto")</h2><EditForm Model="model" OnValidSubmit="Save" Context="productForm"><DataAnnotationsValidator /><ValidationSummary /><div class="field"><label>Nombre</label><InputText class="form-control" @bind-Value="model.Name" /></div><div class="field"><label>Descripción</label><InputTextArea class="form-control" @bind-Value="model.Description" /></div><div class="field"><label>Unidad de medida</label><InputText class="form-control" @bind-Value="model.UnitOfMeasure" /></div><div class="form-row"><div class="field"><label>Stock actual</label><InputNumber class="form-control" @bind-Value="model.CurrentStock" /></div><div class="field"><label>Stock mínimo</label><InputNumber class="form-control" @bind-Value="model.MinimumStock" /></div></div><div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="model.IsActive" /><label>Producto activo</label></div><button class="btn btn-primary">Guardar cambios</button></EditForm></aside></Authorized></AuthorizeView></div>
@code { List<ProductResponse> items=[]; ProductRequest model=new(); int editingId; string search=""; protected override async Task OnInitializedAsync()=>await Load(); async Task Load()=>items=await Http.GetFromJsonAsync<List<ProductResponse>>("api/products")??[]; void New(){editingId=0;model=new(){IsActive=true};} void Edit(ProductResponse x){editingId=x.Id;model=new(){Name=x.Name,Description=x.Description,UnitOfMeasure=x.UnitOfMeasure,CurrentStock=x.CurrentStock,MinimumStock=x.MinimumStock,IsActive=x.IsActive};} async Task Save(){var r=editingId==0?await Http.PostAsJsonAsync("api/products",model):await Http.PutAsJsonAsync($"api/products/{editingId}",model);if(r.IsSuccessStatusCode){New();await Load();}} async Task Toggle(ProductResponse x){var r=await Http.PatchAsJsonAsync($"api/products/{x.Id}/status",new ProductStatusRequest{IsActive=!x.IsActive});if(r.IsSuccessStatusCode)await Load();} }
