@page "/inventory-movements"
@attribute [Authorize(Roles="Administrador,Almacén,Producción,Gerencia")]
@inject HttpClient Http
<PageTitle>Movimientos | Palma Verde</PageTitle><header class="page-heading"><div><p class="eyebrow">Historial</p><h1>Movimientos de inventario</h1><p>Entradas de producción y salidas por despacho.</p></div></header>
<div class="inventory-filters"><select class="form-select" @bind="productId"><option value="0">Todos los productos</option>@foreach(var p in products){<option value="@p.Id">@p.Name</option>}</select><select class="form-select" @bind="type"><option value="">Todos los tipos</option><option value="EntradaProduccion">Entrada producción</option><option value="SalidaDespacho">Salida despacho</option></select><input class="form-control" type="date" @bind="from"/><input class="form-control" type="date" @bind="to"/><button class="btn btn-primary" @onclick="Load">Filtrar</button></div>
<section class="data-panel"><table class="table"><thead><tr><th>Fecha</th><th>Producto</th><th>Tipo</th><th>Cantidad</th><th>Usuario</th><th>Referencia</th></tr></thead><tbody>@foreach(var x in items){<tr><td>@x.Date.ToString("dd/MM/yyyy HH:mm")</td><td>@x.ProductName</td><td>@x.MovementType</td><td class="@(x.MovementType=="SalidaDespacho"?"movement-out":"movement-in")">@(x.MovementType=="SalidaDespacho"?"-":"+")@x.Quantity.ToString("N2")</td><td>@x.Username</td><td>@x.Reference</td></tr>}</tbody></table></section>
@code{List<InventoryMovementResponse>items=[];List<ProductResponse>products=[];int productId;string type="";DateTime?from,to;protected override async Task OnInitializedAsync(){products=await Http.GetFromJsonAsync<List<ProductResponse>>("api/products")??[];await Load();}async Task Load(){var q=new List<string>();if(productId>0)q.Add($"productId={productId}");if(type!="")q.Add($"type={type}");if(from.HasValue)q.Add($"from={from:yyyy-MM-dd}");if(to.HasValue)q.Add($"to={to:yyyy-MM-dd}");items=await Http.GetFromJsonAsync<List<InventoryMovementResponse>>("api/inventory/movements?"+string.Join("&",q))??[];}}
