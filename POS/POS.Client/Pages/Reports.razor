@page "/reports"
@attribute [Authorize(Roles="Administrador,Almacén,Producción,Gerencia")]
@inject HttpClient Http
<PageTitle>Reportes | Palma Verde</PageTitle><header class="page-heading"><div><p class="eyebrow">Información ejecutiva</p><h1>Reportes</h1><p>Producción, inventario y distribución.</p></div></header><div class="inventory-filters"><input class="form-control" type="date" @bind="from"/><input class="form-control" type="date" @bind="to"/><button class="btn btn-primary" @onclick="Load">Actualizar</button></div>
<AuthorizeView Roles="Administrador,Producción,Gerencia"><Authorized><h2>Producción</h2><section class="data-panel report-section"><table class="table"><thead><tr><th>Lote</th><th>Producto</th><th>Inicio</th><th>Fin</th><th>Planificado</th><th>Producido</th><th>Estado</th></tr></thead><tbody>@foreach(var x in production){<tr><td>@x.Code</td><td>@x.ProductName</td><td>@x.StartDate.ToString("dd/MM/yyyy")</td><td>@(x.EndDate?.ToString("dd/MM/yyyy")??"—")</td><td>@x.PlannedQuantity</td><td>@x.ProducedQuantity</td><td>@x.Status</td></tr>}</tbody></table></section></Authorized></AuthorizeView>
<AuthorizeView Roles="Administrador,Almacén,Gerencia"><Authorized><h2>Inventario</h2><section class="data-panel report-section"><table class="table"><thead><tr><th>Tipo</th><th>Nombre</th><th>Unidad</th><th>Actual</th><th>Mínimo</th><th>Estado</th></tr></thead><tbody>@foreach(var x in inventory){<tr class="@(x.IsLowStock?"stock-alert":"")"><td>@x.ItemType</td><td>@x.Name</td><td>@x.UnitOfMeasure</td><td>@x.CurrentStock</td><td>@x.MinimumStock</td><td>@(x.IsLowStock?"STOCK BAJO":x.IsActive?"Activo":"Inactivo")</td></tr>}</tbody></table></section><h2>Despachos</h2><section class="data-panel report-section"><table class="table"><thead><tr><th>#</th><th>Fecha</th><th>Destino</th><th>Responsable</th><th>Producto</th><th>Cantidad</th><th>Estado</th></tr></thead><tbody>@foreach(var x in dispatches){<tr><td>@x.DispatchId</td><td>@x.Date.ToString("dd/MM/yyyy")</td><td>@x.Destination</td><td>@x.Username</td><td>@x.ProductName</td><td>@x.Quantity</td><td>@x.Status</td></tr>}</tbody></table></section></Authorized></AuthorizeView>
@code{[CascadingParameter]public Task<AuthenticationState>?StateTask{get;set;}DateTime?from=DateTime.Today.AddMonths(-1),to=DateTime.Today;List<ProductionReportRow>production=[];List<InventoryReportRow>inventory=[];List<DispatchReportRow>dispatches=[];protected override async Task OnInitializedAsync()=>await Load();async Task Load(){var role=(await StateTask!).User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;var q=$"?from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}";if(role is "Administrador" or "Producción" or "Gerencia")production=await Http.GetFromJsonAsync<List<ProductionReportRow>>("api/reports/production"+q)??[];if(role is "Administrador" or "Almacén" or "Gerencia"){inventory=await Http.GetFromJsonAsync<List<InventoryReportRow>>("api/reports/inventory")??[];dispatches=await Http.GetFromJsonAsync<List<DispatchReportRow>>("api/reports/dispatches"+q)??[];}}}
