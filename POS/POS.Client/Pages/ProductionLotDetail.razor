@page "/production-lots/{Id:int}"
@attribute [Authorize(Roles = "Administrador,Almacén,Producción,Gerencia")]
@inject HttpClient Http
<PageTitle>Detalle de lote | Palma Verde</PageTitle>
@if(!string.IsNullOrWhiteSpace(error)){<div class="alert alert-danger">@error</div>}
@if(item is null){<p>Cargando lote...</p>}else{
<header class="page-heading"><div><p class="eyebrow">Lote @item.Code</p><h1>@item.ProductName</h1><p>Responsable: @item.Username · Inicio: @item.StartDate.ToString("dd/MM/yyyy")</p></div><span class="status-chip">@item.Status</span></header>
<div class="lot-summary"><div><small>Planificado</small><strong>@item.PlannedQuantity @item.ProductUnitOfMeasure</strong></div><div><small>Producido</small><strong>@item.ProducedQuantity @item.ProductUnitOfMeasure</strong></div><div><small>Finalización</small><strong>@(item.EndDate?.ToString("dd/MM/yyyy HH:mm")??"—")</strong></div></div>
<section class="data-panel"><table class="table"><thead><tr><th>Materia prima</th><th>Unidad</th><th>Cantidad utilizada</th></tr></thead><tbody>@if(item.Materials.Count==0){<tr><td colspan="3" class="muted">El lote todavía no registra consumo.</td></tr>}@foreach(var d in item.Materials){<tr><td><strong>@d.RawMaterialName</strong></td><td>@d.UnitOfMeasure</td><td>@d.QuantityUsed.ToString("N2")</td></tr>}</tbody></table></section>
<AuthorizeView Roles="Administrador,Producción"><Authorized>
@if(item.Status==ProductionLotStatuses.Pending){<section class="form-panel lot-action"><h2>Iniciar producción</h2><p>El sistema calculará y descontará automáticamente las materias primas de la receta para @item.PlannedQuantity unidades.</p><button class="btn btn-primary" disabled="@saving" @onclick="Start">@(saving?"Calculando...":"Iniciar y consumir receta")</button></section>}
@if(item.Status==ProductionLotStatuses.InProgress){<section class="form-panel lot-action"><h2>Finalizar lote</h2><div class="field"><label>Unidades producidas</label><input class="form-control" type="number" min="1" step="1" @bind="finish.ProducedQuantity"/><small>Solo se permiten números enteros.</small></div><button class="btn btn-primary" disabled="@saving" @onclick="Finish">Finalizar lote</button></section>}
</Authorized></AuthorizeView><a class="btn btn-light mt-3" href="production-lots">Volver a lotes</a>}
@code {
 [Parameter] public int Id{get;set;} ProductionLotResponse? item; FinishProductionLotRequest finish=new(); string error=""; bool saving;
 protected override async Task OnParametersSetAsync()=>item=await Http.GetFromJsonAsync<ProductionLotResponse>($"api/production-lots/{Id}");
 async Task Start(){saving=true;error="";var response=await Http.PostAsync($"api/production-lots/{Id}/start",null);saving=false;if(response.IsSuccessStatusCode){item=await response.Content.ReadFromJsonAsync<ProductionLotResponse>();return;}try{error=(await response.Content.ReadFromJsonAsync<ApiError>())?.Message??"No fue posible iniciar la producción.";}catch{error="No fue posible iniciar la producción.";}}
 async Task Finish(){await Send($"api/production-lots/{Id}/finish",finish);}
 async Task Send<T>(string url,T body){saving=true;error="";var response=await Http.PostAsJsonAsync(url,body);saving=false;if(response.IsSuccessStatusCode){item=await response.Content.ReadFromJsonAsync<ProductionLotResponse>();return;}try{error=(await response.Content.ReadFromJsonAsync<ApiError>())?.Message??"No fue posible completar la operación.";}catch{error="No fue posible completar la operación.";}}
 sealed class ApiError{public string Message{get;set;}="";}
}
