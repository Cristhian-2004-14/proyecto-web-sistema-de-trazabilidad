@page "/suppliers"
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
<PageTitle>Proveedores | Palma Verde</PageTitle><header class="page-heading"><div><p class="eyebrow">Catálogo de origen</p><h1>Proveedores</h1><p>Información de contacto para futuras recepciones.</p></div><button class="btn btn-primary" @onclick="New">Nuevo proveedor</button></header><div class="workspace-grid"><section class="data-panel"><table class="table"><thead><tr><th>Proveedor</th><th>NIT</th><th>Contacto</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var x in items){<tr><td><strong>@x.Name</strong><small>@x.Address</small></td><td>@x.Nit</td><td>@x.Phone</td><td><span class="status-chip @(x.IsActive?"":"off")">@(x.IsActive?"Activo":"Inactivo")</span></td><td><button class="btn-link-action" @onclick="()=>Edit(x)">Editar</button></td></tr>}</tbody></table></section><aside class="form-panel"><h2>@(model.Id==0?"Nuevo proveedor":"Editar proveedor")</h2><EditForm Model="model" OnValidSubmit="Save"><DataAnnotationsValidator /><div class="field"><label>Nombre</label><InputText class="form-control" @bind-Value="model.Name" /><ValidationMessage For="@(()=>model.Name)" /></div><div class="field"><label>NIT</label><InputText class="form-control" @bind-Value="model.Nit" /></div><div class="field"><label>Teléfono</label><InputText class="form-control" @bind-Value="model.Phone" /></div><div class="field"><label>Dirección</label><InputText class="form-control" @bind-Value="model.Address" /></div><div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="model.IsActive" /><label>Proveedor activo</label></div><button class="btn btn-primary">Guardar cambios</button></EditForm></aside></div>
@code { List<Supplier> items=[]; Supplier model=new(); protected override async Task OnInitializedAsync()=>await Load(); async Task Load()=>items=await Http.GetFromJsonAsync<List<Supplier>>("api/suppliers")??[]; void New()=>model=new(); void Edit(Supplier x)=>model=new(){Id=x.Id,Name=x.Name,Nit=x.Nit,Phone=x.Phone,Address=x.Address,IsActive=x.IsActive}; async Task Save(){var r=model.Id==0?await Http.PostAsJsonAsync("api/suppliers",model):await Http.PutAsJsonAsync($"api/suppliers/{model.Id}",model);if(r.IsSuccessStatusCode){New();await Load();}} }
