@page "/receptions/{Id:int}"
@attribute [Authorize(Roles = "Administrador,Almacén,Producción,Gerencia")]
@inject HttpClient Http
<PageTitle>Detalle de recepción | Palma Verde</PageTitle>
@if(item is null){<p>Cargando recepción...</p>}else{
<header class="page-heading"><div><p class="eyebrow">Recepción #@item.Id</p><h1>@item.SupplierName</h1><p>Registrada por @item.Username el @item.Date.ToString("dd/MM/yyyy HH:mm").</p></div><span class="status-chip">@item.Status</span></header>
<section class="data-panel"><table class="table"><thead><tr><th>Materia prima</th><th>Unidad</th><th>Cantidad recibida</th></tr></thead><tbody>@foreach(var d in item.Details){<tr><td><strong>@d.RawMaterialName</strong></td><td>@d.UnitOfMeasure</td><td>@d.Quantity.ToString("N2")</td></tr>}</tbody></table></section>
<div class="reception-note"><strong>Observación</strong><p>@(string.IsNullOrWhiteSpace(item.Observation)?"Sin observaciones.":item.Observation)</p></div><a class="btn btn-light" href="receptions">Volver a recepciones</a>}
@code { [Parameter] public int Id{get;set;} ReceptionResponse? item; protected override async Task OnParametersSetAsync()=>item=await Http.GetFromJsonAsync<ReceptionResponse>($"api/receptions/{Id}"); }
