    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a69f4d74-3261-4b8f-871c-08d0e9cc49c2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
